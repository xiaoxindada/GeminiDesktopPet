@echo off
setlocal
set "SCRIPT_DIR=%~dp0"
set "APPDATA_DIR=%APPDATA%\GeminiDesktopPet"
set "STARTUP_DIR=%APPDATA%\Microsoft\Windows\Start Menu\Programs\Startup"
set "STARTUP_VBS=%STARTUP_DIR%\GeminiDesktopPet_FollowWatcher.vbs"
set "TEMPLATE_VBS=%SCRIPT_DIR%FollowAppsWatcher.template.vbs"
set "START_BAT=%SCRIPT_DIR%StartPet.bat"
set "STOP_BAT=%SCRIPT_DIR%StopPet.bat"
set "TOKEN_FILE=%APPDATA_DIR%\watcher_token.txt"
set "PET_PATH_FILE=%APPDATA_DIR%\pet_path.txt"
set "START_BAT_FILE=%APPDATA_DIR%\start_bat_path.txt"
set "STOP_BAT_FILE=%APPDATA_DIR%\stop_bat_path.txt"

set "FROM_APP=0"
set "NO_LAUNCH=0"
for %%A in (%*) do (
    if /I "%%~A"=="/from-app" set "FROM_APP=1"
    if /I "%%~A"=="/no-launch" set "NO_LAUNCH=1"
)

if not exist "%APPDATA_DIR%" mkdir "%APPDATA_DIR%" >nul 2>&1
if not exist "%STARTUP_DIR%" mkdir "%STARTUP_DIR%" >nul 2>&1

if not exist "%TEMPLATE_VBS%" (
    if exist "%SCRIPT_DIR%..\Scripts\FollowAppsWatcher.template.vbs" (
        set "TEMPLATE_VBS=%SCRIPT_DIR%..\Scripts\FollowAppsWatcher.template.vbs"
    )
)
if not exist "%TEMPLATE_VBS%" exit /b 1

for %%F in ("%START_BAT%") do set "START_BAT=%%~fF"
for %%F in ("%STOP_BAT%") do set "STOP_BAT=%%~fF"

set "PET_EXE="
if exist "%SCRIPT_DIR%..\GeminiDesktopPet.exe" set "PET_EXE=%SCRIPT_DIR%..\GeminiDesktopPet.exe"
if not defined PET_EXE if exist "%PET_PATH_FILE%" (
    for /f "usebackq delims=" %%P in ("%PET_PATH_FILE%") do (
        if exist "%%~P" set "PET_EXE=%%~P"
    )
)
if not defined PET_EXE if exist "%SCRIPT_DIR%..\bin\Release\net10.0-windows\GeminiDesktopPet.exe" set "PET_EXE=%SCRIPT_DIR%..\bin\Release\net10.0-windows\GeminiDesktopPet.exe"
if not defined PET_EXE if exist "%SCRIPT_DIR%..\bin\Debug\net10.0-windows\GeminiDesktopPet.exe" set "PET_EXE=%SCRIPT_DIR%..\bin\Debug\net10.0-windows\GeminiDesktopPet.exe"
if defined PET_EXE (
    for %%F in ("%PET_EXE%") do set "PET_EXE=%%~fF"
    >"%PET_PATH_FILE%" echo %PET_EXE%
)

>"%START_BAT_FILE%" echo %START_BAT%
>"%STOP_BAT_FILE%" echo %STOP_BAT%

if "%FROM_APP%"=="0" if defined PET_EXE (
    "%PET_EXE%" --follow-flag:on >nul 2>&1
)

if exist "%TOKEN_FILE%" (
    for /f "usebackq delims=" %%T in ("%TOKEN_FILE%") do (
        if /I "%%~T"=="STOP" del /f /q "%TOKEN_FILE%" >nul 2>&1
    )
)

(
    echo ' Dynamically generated by GeminiDesktopPet EnableFollow.bat
    echo ' Runs at Windows logon from shell:startup; deleted when follow stops.
    echo Option Explicit
    echo On Error Resume Next
    echo.
    echo Dim DEFAULT_START_BAT, DEFAULT_STOP_BAT, DEFAULT_PET_EXE
    echo DEFAULT_START_BAT = "%START_BAT%"
    echo DEFAULT_STOP_BAT = "%STOP_BAT%"
    echo DEFAULT_PET_EXE = "%PET_EXE%"
    echo.
) > "%STARTUP_VBS%"
type "%TEMPLATE_VBS%" >> "%STARTUP_VBS%"

if not exist "%STARTUP_VBS%" exit /b 2

if "%NO_LAUNCH%"=="0" (
    start "" wscript.exe //Nologo "%STARTUP_VBS%" /auto
)

exit /b 0
