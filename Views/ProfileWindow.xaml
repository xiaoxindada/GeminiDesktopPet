<Window x:Class="GeminiDesktopPet.Views.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gemini 娘 · 角色档案与设定图鉴"
        Icon="pack://application:,,,/Assets/AppIcon.ico"
        Width="880" Height="660"
        MinWidth="720" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="#131024"
        Foreground="#F4F2FF"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#B9B2DE"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Margin="0,0,8,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#32285E"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#251D47"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E1938" CornerRadius="14" Padding="18,14" Margin="0,0,0,14" BorderBrush="#3C316E" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="ProfileNameText" Text="✦ Gemini 娘" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <Border Background="#3B2B72" CornerRadius="8" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ProfileAliasText" Text="双子娘 · Q版猫娘桌宠" FontSize="11.5" Foreground="#D8CCFF"/>
                        </Border>
                        <Border Background="#3B1A3A" CornerRadius="8" Padding="8,3" Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ProfileBadgeTagText" Text="左玫红 × 右琥珀金 异色瞳" FontSize="11.5" Foreground="#F9A8D4"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="ProfileSubtitleText"
                               Text="Google Gemini 同人拟人形象 · 蓝紫渐变长卷发 / 粉色内耳猫耳 / 虹彩四芒星发饰"
                               FontSize="12.5" Foreground="#B5AED8" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,0,0">
                    <TextBlock x:Name="BondText" Text="好感度 20 ✦ 累计摸头 0 次" FontSize="13" FontWeight="SemiBold" Foreground="#FBBF24" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="SourceLinkText"
                               Text="来源：genderswapai.com/zh-CN/ai-gijinka/gemini"
                               FontSize="11" Foreground="#8E86BA" Margin="0,4,0,0" HorizontalAlignment="Right"
                               Cursor="Hand" MouseLeftButtonUp="SourceLink_Click" TextDecorations="Underline"/>
                    <Button Content="✏️ 自定义角色设定..." Click="EditProfileBtn_Click"
                            HorizontalAlignment="Right" Margin="0,8,0,0" Padding="10,4" FontSize="11.5"
                            Background="#32285E" Foreground="#FFFFFF" BorderBrush="#5B49A8" BorderThickness="1" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content Tabs -->
        <TabControl x:Name="MainTabs" Grid.Row="1" Background="Transparent" BorderThickness="0">
            <!-- Tab 1: Character Profile -->
            <TabItem Header="✦ 角色档案与设定">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#1B1633" CornerRadius="14" Padding="12" BorderBrush="#342A60" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Background="#130F26" CornerRadius="10" Padding="6" BorderBrush="#2D2454" BorderThickness="1">
                                <Image x:Name="StandeeImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.4" Color="#7C5CFF"/>
                                    </Image.Effect>
                                </Image>
                            </Border>
                            <TextBlock x:Name="StandeeCaptionText" Grid.Row="1" Text="Gemini 娘 · 原案立绘参考（ZipZipPipe）" FontSize="11.5" Foreground="#A59EC9" HorizontalAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Background="#1B1633" CornerRadius="12" Padding="14" BorderBrush="#342A60" BorderThickness="1" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="角色简介" FontSize="15" FontWeight="Bold" Foreground="#E9E4FF" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="ProfileBioText" TextWrapping="Wrap" LineHeight="21" FontSize="13" Foreground="#CFC8EE"
                                               Text="Gemini 娘是 Google 旗下 AI 模型 Gemini 的女性拟人化角色。"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="外貌与设定要点" FontSize="15" FontWeight="Bold" Foreground="#E9E4FF" Margin="2,0,0,8"/>
                            <ItemsControl x:Name="TraitsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1B1633" CornerRadius="10" Padding="12,10" Margin="0,0,0,8" BorderBrush="#2E2554" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" Foreground="#C4B5FD"/>
                                                <TextBlock Text="{Binding Detail}" FontSize="12.5" Foreground="#BDB6DF" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Tab 2: Turnaround -->
            <TabItem Header="📐 角色三视图参考">
                <Border Margin="0,12,0,0" Background="#1B1633" CornerRadius="14" Padding="14" BorderBrush="#342A60" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Image x:Name="TurnaroundImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.35" Color="#7C5CFF"/>
                            </Image.Effect>
                        </Image>
                        <TextBlock x:Name="TurnaroundCaptionText" Grid.Row="1" Text="正面 · 侧面 · 背面 三视图（GenderSwapAI 基于 ZipZipPipe 设定制作）" FontSize="12" Foreground="#B5AED8" HorizontalAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </Grid>
                </Border>
            </TabItem>

            <!-- Tab 3: Chibi Expressions -->
            <TabItem Header="🐱 Q版表情动作图鉴（点击可试演）">
                <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="SpritesGallery">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="SpriteCard_Click" Tag="{Binding Key}" Cursor="Hand" Margin="0,0,10,10" Padding="0" Background="Transparent" BorderThickness="0">
                                    <Border Width="118" Background="#1D1836" CornerRadius="12" Padding="8" BorderBrush="#362C63" BorderThickness="1">
                                        <StackPanel>
                                            <Image Source="{Binding Image}" Height="106" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Text="{Binding Key}" FontSize="11.5" Foreground="#D7D0F5" HorizontalAlignment="Center" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Footer attribution -->
        <Border Grid.Row="2" Background="#1A1530" CornerRadius="10" Padding="12,8" Margin="0,12,0,0" BorderBrush="#2E2554" BorderThickness="1">
            <TextBlock x:Name="ProfileFooterText" FontSize="11.5" Foreground="#9B93C4" TextWrapping="Wrap"
                       Text="美术署名：原作形象设定 ZipZipPipe（Bilibili）；Q 版猫娘立绘与表情素材由 CrossPet (lokicorvus) 基于 CC BY-NC-SA 4.0 协议发布（非商业使用、保留署名、相同方式共享）。"/>
        </Border>
    </Grid>
</Window>
