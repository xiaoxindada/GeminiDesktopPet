<Window x:Class="GeminiDesktopPet.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="⚙️ Gemini 娘 · 偏好设置"
        Icon="pack://application:,,,/Assets/AppIcon.ico"
        Width="500" Height="740"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#141126"
        Foreground="#F4F2FF"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>
            <TextBlock Text="✦ 桌面宠偏好设置" FontSize="20" FontWeight="Bold" Margin="0,0,0,14"/>

            <!-- Appearance -->
            <Border Background="#1D1836" CornerRadius="12" Padding="14" Margin="0,0,0,12" BorderBrush="#342B61" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="形象与外观" FontSize="14" FontWeight="SemiBold" Foreground="#C4B5FD" Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="形象版本" VerticalAlignment="Center" Foreground="#DAD3FA"/>
                        <ComboBox x:Name="StyleModeBox" Grid.Column="1" DisplayMemberPath="Label" SelectedValuePath="Id"
                                  SelectionChanged="AnyOption_Changed"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="48"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="人物缩放" VerticalAlignment="Center" Foreground="#DAD3FA"/>
                        <Slider x:Name="ScaleSlider" Grid.Column="1" Minimum="0.6" Maximum="1.8" TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="AnyOption_Changed"/>
                        <TextBlock x:Name="ScaleLabel" Grid.Column="2" Text="1.00x" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#A78BFA"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="48"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="透明度" VerticalAlignment="Center" Foreground="#DAD3FA"/>
                        <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="0.4" Maximum="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="AnyOption_Changed"/>
                        <TextBlock x:Name="OpacityLabel" Grid.Column="2" Text="100%" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#A78BFA"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="装扮主题" VerticalAlignment="Center" Foreground="#DAD3FA"/>
                        <ComboBox x:Name="CostumeBox" Grid.Column="1" DisplayMemberPath="Label" SelectedValuePath="Id"
                                  SelectionChanged="AnyOption_Changed"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Behavior -->
            <Border Background="#1D1836" CornerRadius="12" Padding="14" Margin="0,0,0,12" BorderBrush="#342B61" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="行为与物理互动" FontSize="14" FontWeight="SemiBold" Foreground="#C4B5FD" Margin="0,0,0,8"/>
                    <CheckBox x:Name="AlwaysOnTopCheck" Content="窗口始终置顶（覆盖其他应用之上）" Foreground="#EAE6FF" Margin="0,4" Checked="AnyOption_Changed" Unchecked="AnyOption_Changed"/>
                    <CheckBox x:Name="AutoWalkCheck" Content="桌面自由漫步（在任务栏上左右巡逻）" Foreground="#EAE6FF" Margin="0,4" Checked="AnyOption_Changed" Unchecked="AnyOption_Changed"/>
                    <CheckBox x:Name="AntiGravityCheck" Content="反重力悬浮模式（Antigravity 常驻漂浮）" Foreground="#EAE6FF" Margin="0,4" Checked="AnyOption_Changed" Unchecked="AnyOption_Changed"/>
                    <CheckBox x:Name="GravityCheck" Content="松手重力下落与 Q 弹着陆" Foreground="#EAE6FF" Margin="0,4" Checked="AnyOption_Changed" Unchecked="AnyOption_Changed"/>
                    <CheckBox x:Name="EdgeDockCheck" Content="拖动到屏幕左右边缘时贴边偷看" Foreground="#EAE6FF" Margin="0,4" Checked="AnyOption_Changed" Unchecked="AnyOption_Changed"/>
                    <CheckBox x:Name="ParticlesCheck" Content="四芒星✦与爱心♥粒子特效" Foreground="#EAE6FF" Margin="0,4" Checked="AnyOption_Changed" Unchecked="AnyOption_Changed"/>
                    <CheckBox x:Name="SoundCheck" Content="互动音效（呼噜、星铃、弹跳）" Foreground="#EAE6FF" Margin="0,4" Checked="AnyOption_Changed" Unchecked="AnyOption_Changed"/>
                    <CheckBox x:Name="SysMonCheck" Content="电脑状态感知（低电量打盹 / 高 CPU 提示）" Foreground="#EAE6FF" Margin="0,4" Checked="AnyOption_Changed" Unchecked="AnyOption_Changed"/>
                    <CheckBox x:Name="ShowSpeechBubbleCheck" Content="自动弹出宠物对话气泡（默认关闭，需要时在菜单中打开）" Foreground="#EAE6FF" Margin="0,4" Checked="AnyOption_Changed" Unchecked="AnyOption_Changed"/>
                    <CheckBox x:Name="AutoStartCheck" Content="Windows 开机自动启动" Foreground="#EAE6FF" Margin="0,4" Checked="AutoStart_Changed" Unchecked="AutoStart_Changed"/>
                </StackPanel>
            </Border>

            <!-- App Follow Launch (Native Daemon) -->
            <Border Background="#1D1836" CornerRadius="12" Padding="14" Margin="0,0,0,12" BorderBrush="#342B61" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="应用启动联动（原生后台待机守护）" FontSize="14" FontWeight="SemiBold" Foreground="#C4B5FD" Margin="0,0,0,8"/>

                    <WrapPanel Margin="0,0,0,8">
                        <Border Background="#252048" CornerRadius="8" Padding="8,3" Margin="0,0,6,4">
                            <TextBlock x:Name="AgStatusText" Text="检测中..." FontSize="11" Foreground="#C4B5FD"/>
                        </Border>
                        <Border Background="#252048" CornerRadius="8" Padding="8,3" Margin="0,0,6,4">
                            <TextBlock x:Name="GeminiStatusText" Text="检测中..." FontSize="11" Foreground="#C4B5FD"/>
                        </Border>
                        <Border Background="#252048" CornerRadius="8" Padding="8,3" Margin="0,0,0,4">
                            <TextBlock x:Name="VbsStatusText" Text="联动状态检测中..." FontSize="11" Foreground="#C4B5FD"/>
                        </Border>
                    </WrapPanel>

                    <TextBlock Text="勾选后由主程序在系统托盘原生监听 Antigravity.exe / Gemini.exe，并注册当前用户开机静默待机入口，不写入外部 VBS 脚本。"
                               TextWrapping="Wrap" FontSize="11.5" Foreground="#9D95C8" Margin="0,0,0,8"/>
                    <CheckBox x:Name="FollowAntigravityCheck" Content="跟随 Antigravity 启动而启动" Foreground="#EAE6FF" Margin="0,4" Checked="FollowOptions_Changed" Unchecked="FollowOptions_Changed"/>
                    <CheckBox x:Name="FollowGeminiAppCheck" Content="跟随 Gemini 桌面 App 启动而启动" Foreground="#EAE6FF" Margin="0,4" Checked="FollowOptions_Changed" Unchecked="FollowOptions_Changed"/>
                    <CheckBox x:Name="SleepOnAgExitCheck" Content="被跟随应用全部关闭时自动隐藏待机（下次开启软件时再唤醒）" Foreground="#EAE6FF" Margin="0,4" Checked="AnyOption_Changed" Unchecked="AnyOption_Changed"/>

                    <WrapPanel Margin="0,8,0,0">
                        <Button x:Name="RestartVbsBtn" Content="🔄 启用并同步开机联动" Padding="10,5" FontSize="11.5" Margin="0,0,8,4" Click="RestartVbsBtn_Click"/>
                        <Button x:Name="StopDeleteVbsBtn" Content="⏹ 停用联动与开机待机" Padding="10,5" FontSize="11.5" Margin="0,0,8,4" Click="StopDeleteVbsBtn_Click"/>
                        <Button x:Name="OpenVbsFolderBtn" Content="📂 打开配置目录" Padding="10,5" FontSize="11.5" Margin="0,0,0,4" Click="OpenVbsFolderBtn_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Optional Gemini API -->
            <Border Background="#1D1836" CornerRadius="12" Padding="14" Margin="0,0,0,12" BorderBrush="#342B61" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="可选：联网对话 (Gemini API)" FontSize="14" FontWeight="SemiBold" Foreground="#C4B5FD" Margin="0,0,0,4"/>
                    <TextBlock Text="不填写也可完整使用离线互动、摸头、反重力悬浮与角色档案；填写后可在气泡中输入任意问题与 Gemini 娘对话。"
                               TextWrapping="Wrap" FontSize="11.5" Foreground="#9D95C8" Margin="0,0,0,10"/>

                    <TextBlock Text="Gemini API Key" FontSize="12" Foreground="#D4CEF5" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="ApiKeyBox" Padding="8,6" Background="#120E24" Foreground="#FFFFFF" BorderBrush="#3F3473" Margin="0,0,0,8" PasswordChanged="ApiField_Changed"/>

                    <TextBlock Text="模型名称" FontSize="12" Foreground="#D4CEF5" Margin="0,0,0,4"/>
                    <TextBox x:Name="ModelBox" Padding="8,6" Background="#120E24" Foreground="#FFFFFF" BorderBrush="#3F3473" TextChanged="ApiField_Changed"/>
                </StackPanel>
            </Border>

            <!-- Tips -->
            <Border Background="#19152E" CornerRadius="10" Padding="12" BorderBrush="#2E2656" BorderThickness="1">
                <TextBlock TextWrapping="Wrap" FontSize="11.5" LineHeight="18" Foreground="#ACA4D6"
                           Text="互动小贴士：在猫耳与头顶区域来回滑动鼠标可触发「摸摸头」；按住快速左右甩动会让 Gemini 娘晕头或炸毛生气；右键点击角色可切换 Q 版 / 标准版形象及全部功能。"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
