<Window x:Class="GeminiDesktopPet.Views.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gemini 娘"
        Width="340" Height="420"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">
    <Window.Resources>
        <!-- Quick action pill button -->
        <Style x:Key="QuickPillBtn" TargetType="Button">
            <Setter Property="Background" Value="#2D2454"/>
            <Setter Property="Foreground" Value="#EFEAFF"/>
            <Setter Property="BorderBrush" Value="#544399"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4B3A8F"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#6D4AFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" ClipToBounds="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Particle Layer (4-pointed stars, hearts, Zzz, sparkles) -->
        <Canvas x:Name="ParticleCanvas" Grid.RowSpan="2" IsHitTestVisible="False"/>

        <!-- Top Stage: Speech Bubble + Chat Input + Quick Hover Toolbar -->
        <StackPanel x:Name="StageTopPanel" Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="6,0,6,2">
            <!-- Speech Bubble -->
            <Border x:Name="SpeechBubble"
                    Visibility="Collapsed"
                    MaxWidth="288"
                    Background="#ED17132D"
                    BorderBrush="#7C5CFF"
                    BorderThickness="1.3"
                    CornerRadius="14"
                    Padding="12,9"
                    Margin="0,0,0,6"
                    MouseEnter="Bubble_MouseEnter"
                    MouseLeave="Bubble_MouseLeave">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.45" Color="#0C081C"/>
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,3">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="✦" Foreground="#A78BFA" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="BubbleCharacterNameText" Text="Gemini 娘" FontSize="11" FontWeight="Bold" Foreground="#C4B5FD" VerticalAlignment="Center"/>
                            <TextBlock x:Name="BondBadgeText" Text=" · ♥ 20" FontSize="10.5" Foreground="#F472B6" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Content="✕" Click="CloseBubble_Click" HorizontalAlignment="Right" Width="18" Height="18"
                                Background="Transparent" Foreground="#9B92C7" BorderThickness="0" Cursor="Hand" FontSize="10"/>
                    </Grid>
                    <TextBlock x:Name="BubbleText"
                               Text="喵～Gemini 上线！"
                               TextWrapping="Wrap"
                               FontSize="12.5"
                               LineHeight="18.5"
                               Foreground="#F6F3FF"/>

                    <!-- Inline Chat Input Panel -->
                    <Grid x:Name="ChatInputPanel" Visibility="Collapsed" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ChatTextBox"
                                 Background="#100C20"
                                 Foreground="#FFFFFF"
                                 BorderBrush="#544399"
                                 BorderThickness="1"
                                 Padding="7,5"
                                 FontSize="12"
                                 KeyDown="ChatTextBox_KeyDown"/>
                        <Button Grid.Column="1" Content="发送" Click="SendChat_Click" Margin="6,0,0,0"
                                Style="{StaticResource QuickPillBtn}" Background="#6D4AFF" Foreground="#FFFFFF"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Hover Quick Action Bar -->
            <Border x:Name="QuickBar"
                    Visibility="Collapsed"
                    Background="#E61A1534"
                    BorderBrush="#4D3D8A"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="4,3"
                    HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Button Content="💬 对话" Click="ToggleChat_Click" Style="{StaticResource QuickPillBtn}" ToolTip="打开对话输入"/>
                    <Button x:Name="QuickStyleBtn" Content="🎀 切换形象" Click="ToggleStyleMode_Click" Style="{StaticResource QuickPillBtn}" ToolTip="切换 Q 版 / 标准版形象"/>
                    <Button x:Name="QuickFloatBtn" Content="✨ 悬浮" Click="ToggleAntiGravity_Click" Style="{StaticResource QuickPillBtn}" ToolTip="切换反重力悬浮"/>
                    <Button Content="📖 档案" Click="OpenProfile_Click" Style="{StaticResource QuickPillBtn}" ToolTip="查看角色设定与三视图"/>
                    <Button Content="🆕 更新" Click="OpenUpdate_Click" Style="{StaticResource QuickPillBtn}" ToolTip="检查 GitHub Releases 更新与更新日志"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Bottom Stage: Gemini-chan Static Sprite + 60fps Dynamic Walk Rig -->
        <Grid x:Name="BottomStageGrid" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
            <Grid x:Name="SpriteContainer"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Bottom"
                  Background="Transparent"
                  RenderTransformOrigin="0.5,1.0"
                  Cursor="Hand"
                  MouseLeftButtonDown="PetImage_MouseLeftButtonDown"
                  MouseMove="PetImage_MouseMove"
                  MouseLeftButtonUp="PetImage_MouseLeftButtonUp"
                  MouseRightButtonUp="PetImage_MouseRightButtonUp">
                <Grid.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.30" Color="#191036"/>
                </Grid.Effect>
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="SpriteScale" ScaleX="1" ScaleY="1"/>
                        <RotateTransform x:Name="SpriteRotate" Angle="0"/>
                        <TranslateTransform x:Name="SpriteTranslate" X="0" Y="0"/>
                    </TransformGroup>
                </Grid.RenderTransform>
                <Grid.ContextMenu>
                    <ContextMenu x:Name="PetContextMenu">
                        <MenuItem Header="♥ 摸摸猫耳" Click="MenuPat_Click"/>
                        <MenuItem Header="💬 打开宠物对话框 / 问问题" Click="ToggleChat_Click"/>
                        <MenuItem x:Name="MenuShowSpeechBubble" Header="💭 自动弹出对话气泡" IsCheckable="True" Click="MenuShowSpeechBubble_Click"/>
                        <MenuItem Header="📊 查看反重力额度" Click="OpenQuota_Click"/>
                        <Separator/>
                        <MenuItem Header="🎀 形象切换">
                            <MenuItem x:Name="MenuStyleChibi" Header="Q 版猫娘形象 (Chibi · 默认)" IsCheckable="True" Click="MenuStyleChibi_Click"/>
                            <MenuItem x:Name="MenuStyleStandard" Header="标准立绘形象 (Standard)" IsCheckable="True" Click="MenuStyleStandard_Click"/>
                        </MenuItem>
                        <MenuItem x:Name="MenuAntiGravity" Header="✨ 反重力悬浮模式" IsCheckable="True" Click="MenuAntiGravity_Click"/>
                        <MenuItem x:Name="MenuAutoWalk" Header="🐾 桌面自由漫步" IsCheckable="True" Click="MenuAutoWalk_Click"/>
                        <MenuItem x:Name="MenuFollowAntigravity" Header="🚀 跟随 Antigravity 启动而启动" IsCheckable="True" Click="MenuFollowAntigravity_Click"/>
                        <MenuItem x:Name="MenuFollowGeminiApp" Header="🌟 跟随 Gemini 桌面 App 启动而启动" IsCheckable="True" Click="MenuFollowGeminiApp_Click"/>
                        <MenuItem Header="🎭 动作表现">
                            <MenuItem Header="思考中 (thinking)" Tag="thinking" Click="MenuPose_Click"/>
                            <MenuItem Header="Nano Banana 画笔 (drawing)" Tag="drawing" Click="MenuPose_Click"/>
                            <MenuItem Header="哼小曲 (hum)" Tag="hum" Click="MenuPose_Click"/>
                            <MenuItem Header="伸懒腰 (stretch)" Tag="stretch" Click="MenuPose_Click"/>
                            <MenuItem Header="打哈欠 (yawn)" Tag="yawn" Click="MenuPose_Click"/>
                            <MenuItem Header="打盹睡觉 (sleeping)" Tag="sleeping" Click="MenuPose_Click"/>
                            <MenuItem Header="反重力飘浮 (float)" Tag="float" Click="MenuPose_Click"/>
                            <MenuItem Header="得意叉腰 (proud)" Tag="proud" Click="MenuPose_Click"/>
                            <MenuItem Header="超开心 (happy)" Tag="happy" Click="MenuPose_Click"/>
                            <MenuItem Header="压缩上下文 (compact)" Tag="compact" Click="MenuPose_Click"/>
                        </MenuItem>
                        <MenuItem x:Name="CostumeSubMenu" Header="🎊 节日换装"/>
                        <Separator/>
                        <MenuItem Header="📖 角色档案与三视图" Click="OpenProfile_Click"/>
                        <MenuItem Header="✏️ 自定义角色设定..." Click="OpenCharacterEditor_Click"/>
                        <Separator/>
                        <MenuItem Header="📏 缩放尺寸">
                            <MenuItem Header="小巧 (0.75x)" Tag="0.75" Click="MenuScale_Click"/>
                            <MenuItem Header="标准 (1.00x)" Tag="1.0" Click="MenuScale_Click"/>
                            <MenuItem Header="放大 (1.30x)" Tag="1.3" Click="MenuScale_Click"/>
                            <MenuItem Header="超大 (1.60x)" Tag="1.6" Click="MenuScale_Click"/>
                        </MenuItem>
                        <MenuItem Header="📍 贴靠屏幕边缘">
                            <MenuItem Header="贴靠左边偷看" Tag="left" Click="MenuDock_Click"/>
                            <MenuItem Header="贴靠右边偷看" Tag="right" Click="MenuDock_Click"/>
                            <MenuItem Header="回到地面右下角" Tag="reset" Click="MenuDock_Click"/>
                        </MenuItem>
                        <MenuItem Header="👻 开启鼠标穿透（托盘可取消）" Click="MenuClickThrough_Click"/>
                        <MenuItem Header="💤 隐藏待机（等待联动软件启动）" Click="MenuStandby_Click"/>
                        <MenuItem Header="⚙️ 偏好设置..." Click="OpenSettings_Click"/>
                        <MenuItem Header="🆕 检查更新..." Click="OpenUpdate_Click"/>
                        <Separator/>
                        <MenuItem Header="🌙 让 Gemini 娘休息（退出）" Click="MenuExit_Click"/>
                    </ContextMenu>
                </Grid.ContextMenu>

                <Image x:Name="PetImage"
                       Height="240"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <!-- Q 版侧向全身+肢体协调动态行走骨骼层 -->
                <Grid x:Name="ChibiWalkRig" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                    <Image x:Name="ChibiArmLImg" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.3250,0.5083">
                        <Image.RenderTransform>
                            <RotateTransform x:Name="ChibiArmLRotate" Angle="0"/>
                        </Image.RenderTransform>
                    </Image>
                    <Image x:Name="ChibiLegRImg" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5172,0.7233">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="ChibiLegRScale" ScaleX="1" ScaleY="1"/>
                                <RotateTransform x:Name="ChibiLegRRotate" Angle="0"/>
                                <TranslateTransform x:Name="ChibiLegRMove" X="0" Y="0"/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                    <Image x:Name="ChibiLegLImg" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.3538,0.7233">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="ChibiLegLScale" ScaleX="1" ScaleY="1"/>
                                <RotateTransform x:Name="ChibiLegLRotate" Angle="0"/>
                                <TranslateTransform x:Name="ChibiLegLMove" X="0" Y="0"/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                    <Image x:Name="ChibiBodyImg" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.48,0.56">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <RotateTransform x:Name="ChibiBodyRotate" Angle="0"/>
                                <TranslateTransform x:Name="ChibiBodyMove" X="0" Y="0"/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                    <Image x:Name="ChibiArmRImg" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5643,0.5483">
                        <Image.RenderTransform>
                            <RotateTransform x:Name="ChibiArmRRotate" Angle="0"/>
                        </Image.RenderTransform>
                    </Image>
                </Grid>

                <!-- 标准立绘版动态膝关节行走骨骼层 -->
                <Grid x:Name="StdWalkRig" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                    <Grid x:Name="StdBackLegContainer" RenderTransformOrigin="0.3086,0.5578">
                        <Grid.RenderTransform>
                            <RotateTransform x:Name="StdBackHipRotate" Angle="0"/>
                        </Grid.RenderTransform>
                        <Image x:Name="StdBackThighImg" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Image x:Name="StdBackShinImg" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.3472,0.7022">
                            <Image.RenderTransform>
                                <RotateTransform x:Name="StdBackKneeRotate" Angle="0"/>
                            </Image.RenderTransform>
                        </Image>
                    </Grid>
                    <Grid x:Name="StdFrontLegContainer" RenderTransformOrigin="0.3086,0.5578">
                        <Grid.RenderTransform>
                            <RotateTransform x:Name="StdFrontHipRotate" Angle="0"/>
                        </Grid.RenderTransform>
                        <Image x:Name="StdFrontThighImg" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Image x:Name="StdFrontShinImg" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.3472,0.7022">
                            <Image.RenderTransform>
                                <RotateTransform x:Name="StdFrontKneeRotate" Angle="0"/>
                            </Image.RenderTransform>
                        </Image>
                    </Grid>
                    <Image x:Name="StdBodyImg" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5,0.46">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <RotateTransform x:Name="StdBodyRotate" Angle="0"/>
                                <TranslateTransform x:Name="StdBodyMove" X="0" Y="0"/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
