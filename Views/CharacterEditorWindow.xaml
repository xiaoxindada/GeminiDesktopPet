<Window x:Class="GeminiDesktopPet.Views.CharacterEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="✏️ 自定义角色设定"
        Icon="pack://application:,,,/Assets/AppIcon.ico"
        Width="760" Height="690"
        MinWidth="660" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#131024"
        Foreground="#F4F2FF"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <Window.Resources>
        <Style x:Key="DarkEditBox" TargetType="TextBox">
            <Setter Property="Background" Value="#120E24"/>
            <Setter Property="Foreground" Value="#F6F3FF"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="SelectionBrush" Value="#6D4AFF"/>
            <Setter Property="BorderBrush" Value="#3F3473"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>

        <Style x:Key="PresetChipBtn" TargetType="Button">
            <Setter Property="Background" Value="#251F47"/>
            <Setter Property="Foreground" Value="#EAE6FF"/>
            <Setter Property="BorderBrush" Value="#4D3D8A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,6"/>
            <Setter Property="Margin" Value="0,0,8,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3B2E73"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#7C5CFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#5C44BD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E1938" CornerRadius="14" Padding="16,12" Margin="0,0,0,12" BorderBrush="#3C316E" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="✏️ 可视化角色设定工坊" FontSize="19" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Text="无需手写配置文件：点选预设模板或直接填写名称、性格、台词与立绘即可定制；留空部分将自动使用默认 Gemini 娘设定。"
                               FontSize="12" Foreground="#B5AED8" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1" Content="↺ 恢复默认设定" Padding="11,6" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"
                        Background="#3D1F35" Foreground="#FCA5A5" BorderBrush="#6B2D53" BorderThickness="1"
                        Cursor="Hand" Click="ResetDefaultBtn_Click"/>
            </Grid>
        </Border>

        <!-- Main Scrollable Visual Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel>
                <!-- Step 1: One-click Presets -->
                <Border Background="#1B1633" CornerRadius="12" Padding="14" Margin="0,0,0,12" BorderBrush="#342A60" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="① 一键性格预设（点击可即时预览并继续微调）" FontSize="13.5" FontWeight="SemiBold" Foreground="#C4B5FD" Margin="0,0,0,8"/>
                        <WrapPanel x:Name="PresetButtonsPanel"/>
                    </StackPanel>
                </Border>

                <!-- Step 2: Live Portrait Card + Core Identity -->
                <Border Background="#1B1633" CornerRadius="12" Padding="14" Margin="0,0,0,12" BorderBrush="#342A60" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="178"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Visual Standee Preview -->
                        <Border Grid.Column="0" Background="#130F26" CornerRadius="12" Padding="10" BorderBrush="#2E2554" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="186"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Image x:Name="StandeePreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                    <Button Content="🖼 更换展示立绘..." Padding="8,5" FontSize="11.5" Margin="0,0,0,5"
                                            Background="#2D2357" Foreground="#EFEAFF" BorderBrush="#5B49A8" BorderThickness="1"
                                            Cursor="Hand" Click="PickStandeeBtn_Click"/>
                                    <Button Content="用回默认立绘" Padding="8,4" FontSize="11"
                                            Background="#231D42" Foreground="#B5AED8" BorderBrush="#3E3270" BorderThickness="1"
                                            Cursor="Hand" Click="ClearStandeeBtn_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Core Info -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="② 基本角色信息" FontSize="13.5" FontWeight="SemiBold" Foreground="#C4B5FD" Margin="0,0,0,8"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="角色昵称（气泡 &amp; 档案显示）" FontSize="11.5" Foreground="#B9B2DE" Margin="0,0,0,4"/>
                                    <TextBox x:Name="NameBox" Style="{StaticResource DarkEditBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="副称号 / 小标签" FontSize="11.5" Foreground="#B9B2DE" Margin="0,0,0,4"/>
                                    <TextBox x:Name="AliasBox" Style="{StaticResource DarkEditBox}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="角色性格与背景简介" FontSize="11.5" Foreground="#B9B2DE" Margin="0,0,0,4"/>
                            <TextBox x:Name="BioBox" Style="{StaticResource DarkEditBox}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="68" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8"/>

                            <TextBlock Text="特征标签 / 顶部简介（可选，留空自动沿用默认）" FontSize="11.5" Foreground="#B9B2DE" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="BadgeTagBox" Grid.Column="0" Style="{StaticResource DarkEditBox}"/>
                                <TextBox x:Name="SubtitleBox" Grid.Column="2" Style="{StaticResource DarkEditBox}"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Step 3: AI Tone & Common Dialogue Lines -->
                <Border Background="#1B1633" CornerRadius="12" Padding="14" Margin="0,0,0,12" BorderBrush="#342A60" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="③ 说话风格与常见台词" FontSize="13.5" FontWeight="SemiBold" Foreground="#C4B5FD" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="125"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="AI 对话说话风格" VerticalAlignment="Center" Foreground="#D4CEF5" FontSize="12"/>
                            <ComboBox x:Name="AiToneCombo" Grid.Column="1" DisplayMemberPath="Label" SelectedValuePath="Id"
                                      SelectionChanged="AiToneCombo_SelectionChanged"/>
                        </Grid>

                        <TextBlock Text="AI 性格人设细节（选上方预设会自动填充；留空则自动根据角色信息生成）" FontSize="11.5" Foreground="#B9B2DE" Margin="0,0,0,4"/>
                        <TextBox x:Name="AiPromptBox" Style="{StaticResource DarkEditBox}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="打招呼说的话（每行一条）" FontSize="11.5" Foreground="#B9B2DE" Margin="0,0,0,4"/>
                                <TextBox x:Name="GreetingBox" Style="{StaticResource DarkEditBox}" AcceptsReturn="True" TextWrapping="Wrap" Height="78" VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="摸头时说的话（每行一条）" FontSize="11.5" Foreground="#B9B2DE" Margin="0,0,0,4"/>
                                <TextBox x:Name="PatBox" Style="{StaticResource DarkEditBox}" AcceptsReturn="True" TextWrapping="Wrap" Height="78" VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="平时发呆说的话（每行一条）" FontSize="11.5" Foreground="#B9B2DE" Margin="0,0,0,4"/>
                                <TextBox x:Name="IdleBox" Style="{StaticResource DarkEditBox}" AcceptsReturn="True" TextWrapping="Wrap" Height="78" VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Step 4: Collapsible Advanced Settings -->
                <Expander Background="#19152E" Foreground="#D7D0F5" BorderBrush="#342A60" BorderThickness="1" Padding="10" Margin="0,0,0,6" IsExpanded="False">
                    <Expander.Header>
                        <TextBlock Text="④ 展开更多设定（外貌词条卡片 / 悬浮与闲聊台词 / 自定义三视图 / JSON 文件）" FontSize="12.5" FontWeight="SemiBold" Foreground="#C4B5FD"/>
                    </Expander.Header>
                    <StackPanel Margin="4,10,4,4">
                        <!-- Traits -->
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="外貌与设定要点卡片（清空将自动恢复默认列表）" FontSize="12" FontWeight="SemiBold" Foreground="#E9E4FF" VerticalAlignment="Center"/>
                            <Button Content="＋ 添加一条设定" HorizontalAlignment="Right" Padding="10,4" FontSize="11.5"
                                    Background="#32285E" Foreground="#FFFFFF" BorderBrush="#5B49A8" BorderThickness="1"
                                    Cursor="Hand" Click="AddTraitBtn_Click"/>
                        </Grid>
                        <ItemsControl x:Name="TraitsEditorList" Margin="0,0,0,10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="165"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkEditBox}"/>
                                        <TextBox Grid.Column="2" Text="{Binding Detail, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkEditBox}"/>
                                        <Button Grid.Column="4" Content="删除" Padding="10,6" FontSize="11.5"
                                                Background="#3D1F35" Foreground="#FCA5A5" BorderBrush="#6B2D53" BorderThickness="1"
                                                Cursor="Hand" Tag="{Binding}" Click="RemoveTraitBtn_Click"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- More Lines -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="反重力悬浮台词" FontSize="11.5" Foreground="#B9B2DE" Margin="0,0,0,4"/>
                                <TextBox x:Name="FloatBox" Style="{StaticResource DarkEditBox}" AcceptsReturn="True" TextWrapping="Wrap" Height="64" VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="随机碎碎念台词" FontSize="11.5" Foreground="#B9B2DE" Margin="0,0,0,4"/>
                                <TextBox x:Name="ChatterBox" Style="{StaticResource DarkEditBox}" AcceptsReturn="True" TextWrapping="Wrap" Height="64" VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Grid>

                        <!-- Custom Turnaround Image & Links -->
                        <TextBlock Text="自定义角色三视图路径（留空使用内置原案图）" FontSize="11.5" Foreground="#B9B2DE" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TurnaroundPathBox" Grid.Column="0" Style="{StaticResource DarkEditBox}"/>
                            <Button Grid.Column="2" Content="浏览..." Padding="10,6" FontSize="11.5" Background="#252048" Foreground="#E9E4FF" BorderBrush="#4D3D8A" BorderThickness="1" Cursor="Hand" Click="PickTurnaroundBtn_Click"/>
                            <Button Grid.Column="4" Content="清空" Padding="10,6" FontSize="11.5" Background="#252048" Foreground="#B9B2DE" BorderBrush="#4D3D8A" BorderThickness="1" Cursor="Hand" Click="ClearTurnaroundBtn_Click"/>
                        </Grid>

                        <WrapPanel>
                            <Button Content="📄 打开 character.json 文件" Padding="10,6" FontSize="11.5" Margin="0,0,8,0"
                                    Background="#252048" Foreground="#E9E4FF" BorderBrush="#4D3D8A" BorderThickness="1"
                                    Cursor="Hand" Click="OpenJsonBtn_Click"/>
                            <Button Content="🔄 从文件重载" Padding="10,6" FontSize="11.5"
                                    Background="#252048" Foreground="#E9E4FF" BorderBrush="#4D3D8A" BorderThickness="1"
                                    Cursor="Hand" Click="ReloadJsonBtn_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Action Bar -->
        <Border Grid.Row="2" Background="#1A1530" CornerRadius="10" Padding="12,10" Margin="0,10,0,0" BorderBrush="#342A60" BorderThickness="1">
            <Grid>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12" Foreground="#6EE7B7"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="关闭" Padding="14,7" FontSize="12" Margin="0,0,8,0"
                            Background="#252048" Foreground="#DDD7F8" BorderBrush="#4D3D8A" BorderThickness="1"
                            Cursor="Hand" Click="CloseBtn_Click"/>
                    <Button Content="💾 保存并立即生效" Padding="16,7" FontSize="12.5" FontWeight="SemiBold"
                            Background="#6D4AFF" Foreground="#FFFFFF" BorderBrush="#8B6EFF" BorderThickness="1"
                            Cursor="Hand" Click="SaveBtn_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
