<Window x:Class="GeminiDesktopPet.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🆕 Gemini 娘 · 检查与更新"
        Icon="pack://application:,,,/Assets/AppIcon.ico"
        Width="560" Height="580"
        MinWidth="480" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#141126"
        Foreground="#F4F2FF"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E1938" CornerRadius="14" Padding="16,14" Margin="0,0,0,12" BorderBrush="#3C316E" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="✦ 软件更新中心" FontSize="19" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <Border Background="#32285E" CornerRadius="8" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="CurrentVersionBadge" Text="当前 v0.1.0" FontSize="11.5" Foreground="#D8CCFF"/>
                        </Border>
                        <Border x:Name="LatestBadgeBorder" Background="#252048" CornerRadius="8" Padding="8,3" Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="LatestVersionBadge" Text="最新待检测" FontSize="11.5" Foreground="#B9B2DE"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="UpstreamLinkText"
                               Text="上游追踪源：https://github.com/xiaoxindada/GeminiDesktopPet/releases"
                               FontSize="11.5" Foreground="#9B92D0" Margin="0,7,0,0"
                               Cursor="Hand" TextDecorations="Underline"
                               MouseLeftButtonUp="UpstreamLink_Click"/>
                </StackPanel>

                <Button x:Name="RefreshBtn" Grid.Column="1" Content="🔄 重新检查" Padding="12,7" FontSize="12"
                        Background="#32285E" Foreground="#FFFFFF" BorderBrush="#5B49A8" BorderThickness="1"
                        VerticalAlignment="Center" Cursor="Hand" Click="RefreshBtn_Click"/>
            </Grid>
        </Border>

        <!-- Status & Asset Info -->
        <Border Grid.Row="1" Background="#1B1633" CornerRadius="12" Padding="14,11" Margin="0,0,0,12" BorderBrush="#342A60" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="StatusText" Text="正在连接 GitHub Releases 检查最新版本..." FontSize="13.5" FontWeight="SemiBold" Foreground="#E9E4FF" TextWrapping="Wrap"/>
                <TextBlock x:Name="ReleaseMetaText" Text="将自动解析最新版本（始终指向 /releases/latest）" FontSize="11.5" Foreground="#A59EC9" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Changelog Box -->
        <Border Grid.Row="2" Background="#1B1633" CornerRadius="12" Padding="12" Margin="0,0,0,12" BorderBrush="#342A60" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="📋 更新日志 / Changelog" FontSize="13" FontWeight="SemiBold" Foreground="#C4B5FD" Margin="0,0,0,8"/>
                <TextBox x:Name="ChangelogBox" Grid.Row="1"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Background="#120E24"
                         Foreground="#DDD7F8"
                         BorderBrush="#2E2554"
                         BorderThickness="1"
                         Padding="10"
                         FontSize="12.5"
                         FontFamily="Microsoft YaHei UI, Consolas, Segoe UI"
                         Text="正在读取更新说明与 Git 提交摘要..."/>
            </Grid>
        </Border>

        <!-- Download Progress -->
        <StackPanel x:Name="ProgressPanel" Grid.Row="3" Visibility="Collapsed" Margin="0,0,0,12">
            <Grid Margin="0,0,0,4">
                <TextBlock x:Name="DownloadStatusText" Text="准备下载更新包..." FontSize="12" Foreground="#C4B5FD"/>
                <TextBlock x:Name="DownloadPercentText" Text="0%" FontSize="12" Foreground="#6EE7B7" HorizontalAlignment="Right"/>
            </Grid>
            <ProgressBar x:Name="DownloadProgressBar" Height="8" Minimum="0" Maximum="100" Value="0"
                         Background="#241D44" Foreground="#7C5CFF" BorderThickness="0"/>
        </StackPanel>

        <!-- Bottom Action Bar -->
        <Grid Grid.Row="4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="OpenBrowserBtn" Content="🌐 浏览器打开 Releases" Padding="12,8" FontSize="12" Margin="0,0,8,0"
                        Background="#252048" Foreground="#E9E4FF" BorderBrush="#4D3D8A" BorderThickness="1"
                        Cursor="Hand" Click="OpenBrowserBtn_Click"/>
                <Button x:Name="SkipVersionBtn" Content="⏭ 跳过此版本" Padding="12,8" FontSize="12" Visibility="Collapsed"
                        Background="#252048" Foreground="#B9B2DE" BorderBrush="#4D3D8A" BorderThickness="1"
                        Cursor="Hand" Click="SkipVersionBtn_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="InstallUpdateBtn" Content="⬇ 立即下载并更新" Padding="14,8" FontSize="12.5" FontWeight="SemiBold"
                        Margin="0,0,8,0" IsEnabled="False"
                        Background="#6D4AFF" Foreground="#FFFFFF" BorderBrush="#8B6EFF" BorderThickness="1"
                        Cursor="Hand" Click="InstallUpdateBtn_Click"/>
                <Button Content="关闭" Padding="14,8" FontSize="12"
                        Background="#252048" Foreground="#DDD7F8" BorderBrush="#4D3D8A" BorderThickness="1"
                        Cursor="Hand" Click="CloseBtn_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
