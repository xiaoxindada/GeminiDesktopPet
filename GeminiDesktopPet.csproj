<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <StartupObject>GeminiDesktopPet.Program</StartupObject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <AssemblyName>GeminiDesktopPet</AssemblyName>
    <RootNamespace>GeminiDesktopPet</RootNamespace>
    <Authors>Community Fan Project</Authors>
    <Product>Gemini 娘 · Windows 桌面萌宠</Product>
    <Description>基于 Gender Swap AI 设定的 Gemini 娘 Windows 桌面萌宠（支持 Q 版与标准立绘双形态切换）</Description>
    <DefaultItemExcludes>$(DefaultItemExcludes);publish\**;tools\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Uninstaller\**" />
    <None Include="Uninstaller\Uninstaller.cs" />
    <Resource Include="Assets\AppIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Sprites\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Standard\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Profile\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\WalkRig\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="CREDITS.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="LICENSE">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="VERSION">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="BuildStandaloneUninstaller" AfterTargets="Build" Condition="Exists('C:\Windows\Microsoft.NET\Framework64\v4.0.30319\csc.exe') and Exists('$(ProjectDir)Uninstaller\Uninstaller.cs')">
    <Exec Command="&quot;C:\Windows\Microsoft.NET\Framework64\v4.0.30319\csc.exe&quot; /nologo /target:winexe /optimize+ /win32icon:&quot;$(ProjectDir)Assets\AppIcon.ico&quot; /out:&quot;$(TargetDir)Uninstall.exe&quot; &quot;$(ProjectDir)Uninstaller\Uninstaller.cs&quot;" />
  </Target>

  <Target Name="PublishStandaloneUninstaller" AfterTargets="Publish" Condition="Exists('$(TargetDir)Uninstall.exe')">
    <Copy SourceFiles="$(TargetDir)Uninstall.exe" DestinationFiles="$(PublishDir)Uninstall.exe" OverwriteReadOnlyFiles="true" />
  </Target>

</Project>
